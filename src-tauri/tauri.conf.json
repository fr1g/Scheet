{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scheet",
  "version": "0.1.0",
  "identifier": "com.scheet.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scheet",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "backgroundColor": "#3F3F46"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/scheet/fonts/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
